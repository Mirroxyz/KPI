%% Лабораторна робота №2 - Use Case діаграма
flowchart LR
    User["User"]
    Member["Member"]
    Librarian["Librarian"]
    EmailService["EmailService"]
    User -->|generalization| Member
    User -->|generalization| Librarian
    subgraph System["City Library System"]
        Auth("(Authenticate)")
        Borrow("(Borrow Book)")
        Return("(Return Book)")
        Pay("(Pay Fine)")
        Notify("(Send Notification)")
        Borrow -. "include" .-> Auth
        Return -. "extend" .-> Pay
        EmailService --> Notify
    end
