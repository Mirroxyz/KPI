flowchart LR
    User["User"]
    Member["Member"]
    Librarian["Librarian"]
    EmailService["EmailService"]

    User -->|generalization| Member
    User -->|generalization| Librarian

    subgraph System["City Library System"]
        Auth("(Authenticate)")
        Search("(Search Catalog)")
        Reserve("(Reserve Book)")
        Borrow("(Borrow Book)")
        Return("(Return Book)")
        Pay("(Pay Fine)")
        Notify("(Send Notification)")
        Fulfill("(Fulfill Reservation)")

        Member --> Search
        Member --> Reserve
        Member --> Borrow
        Member --> Return

        Librarian --> Borrow
        Librarian --> Return
        Librarian --> Fulfill

        EmailService --> Notify

        Borrow -. "include" .-> Auth
        Reserve -. "include" .-> Auth
        Fulfill -. "include" .-> Notify
        
        Pay -. "extend" .-> Return
    end
